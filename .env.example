# Copiar a .env (que no se versiona) y completar.

# Base local de docker compose. DATABASE_URL tiene que coincidir con los POSTGRES_*.
POSTGRES_USER=mapa
POSTGRES_PASSWORD=
POSTGRES_DB=mapa
DATABASE_URL=postgresql+psycopg://mapa:<POSTGRES_PASSWORD>@db:5432/mapa

# Firma la cookie del flujo OAuth. Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Credenciales OAuth de Google Cloud (tipo "Aplicación web", app en modo Testing).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URI registrado en Google. Por defecto http://localhost:5173/api/auth/callback (proxy de
# Vite); mientras no exista el frontend se puede usar http://localhost:8000/api/auth/callback.
GOOGLE_REDIRECT_URI=

# true agrega el atributo Secure a las cookies (solo sirve con HTTPS).
COOKIE_SECURE=false

# Adónde redirige el callback después del login.
POST_LOGIN_REDIRECT=/
