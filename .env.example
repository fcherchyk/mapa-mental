# Copy to .env (which is not versioned) and fill in.

# Local docker compose database. DATABASE_URL must match the POSTGRES_* values.
POSTGRES_USER=mapa
POSTGRES_PASSWORD=
POSTGRES_DB=mapa
DATABASE_URL=postgresql+psycopg://mapa:<POSTGRES_PASSWORD>@db:5432/mapa

# Signs the OAuth flow cookie. Generate it with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Google Cloud OAuth credentials ("Web application" type, app in Testing mode).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URI registered in Google. Defaults to http://localhost:5173/api/auth/callback (Vite
# proxy); to try the API on its own you can use http://localhost:8000/api/auth/callback.
GOOGLE_REDIRECT_URI=

# true adds the Secure attribute to the cookies (only works with HTTPS).
COOKIE_SECURE=false

# Where the callback redirects after login.
POST_LOGIN_REDIRECT=/
